# Copy to .env and adjust. Never commit .env.
#
# This file must contain placeholder values only. Real credentials, tokens, and
# any PHI are prohibited in the repository (aidlc-e2e-rules.md §18, §19).

# Base URL of the application under test.
# Defaults to the dev frontend recorded in README.md when unset.
BASE_URL=https://clinical.dev.rethinkbhtech.com/clinical-ui/

# Synthetic test account credentials, supplied by the environment.
# These are placeholders: the authentication mechanism and account provisioning
# are not yet defined (see tests/README.md, decision F-04).
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
