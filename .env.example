# Copy to .env and fill in. NEVER commit .env.
# All secrets live here, never in source or feature files.

BASE_URL=https://clinical.dev2.rethinkbhtech.com
API_BASE_URL=https://dev2.internal.rethinkbhtech.com/mobile-gateway-api
AUTH_BASE_URL=https://dev2.internal.rethinkbhtech.com/mobile-security/api/v1/auth

# OPTIONAL. Decision D1: the suite authenticates by driving /temp-dev-login, which
# signs itself in, and lifts the resulting token out of localStorage. Nothing below
# is needed to run the suite today. Fill these in only once a real service account
# exists and we switch to a credentialed login.
TEST_USERNAME=
TEST_PASSWORD=

# OPTIONAL. The auth endpoints require an x-application-key header. It is fetched
# from the app's own /runtime-config.json at runtime; set this only to override.
AUTH_APPLICATION_KEY=

# Required for `@write` scenarios (Phase 2b). A dedicated client this suite
# is allowed to mutate. Unset → write scenarios fail fast; they never fall
# back to the shared caseload.
# TEST_CLIENT_ID=

# Optional: set to 1 to watch the browser.
# HEADED=1
