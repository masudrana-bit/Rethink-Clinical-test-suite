{
  "name": "rethink-clinical-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + Cucumber (BDD) test automation for Rethink Clinical, built via AIDLC.",
  "scripts": {
    "test": "npm run allure:clean --silent && cucumber-js",
    "test:preflight": "npm run allure:clean --silent && cucumber-js -p preflight",
    "test:smoke": "npm run allure:clean --silent && cucumber-js -p smoke",
    "test:api": "npm run allure:clean --silent && cucumber-js -p api",
    "test:endpoints": "npm run allure:clean --silent && cucumber-js -p endpoints",
    "test:ui": "npm run allure:clean --silent && cucumber-js -p ui",
    "test:write": "npm run allure:clean --silent && cucumber-js -p write",
    "typecheck": "tsc --noEmit",
    "verify:scrub": "ts-node scripts/verify-trace-scrubbing.ts",
    "report": "node scripts/report.js",
    "coverage:inventory": "node scripts/coverage-inventory.js",
    "allure:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.47.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.0.0",
    "adm-zip": "^0.6.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.11.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
