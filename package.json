{
  "name": "rethink-clinical-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + Cucumber (BDD) test automation for Rethink Clinical, built via AIDLC.",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:api": "cucumber-js --tags @api",
    "test:ui": "cucumber-js --tags @ui",
    "report": "node scripts/report.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
