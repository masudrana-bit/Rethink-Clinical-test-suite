{
  // .features-gen holds the Playwright tests that bddgen compiles from the
  // feature files. It is generated, git-ignored, and rewritten on every run.
  // Hiding it keeps the source of truth unambiguous: edit the .feature file or
  // the step definitions, never the generated output.
  //
  // Delete these two entries if you ever need to inspect what was generated.
  "files.exclude": {
    "**/.features-gen": true
  },
  "search.exclude": {
    "**/.features-gen": true
  },

  "files.readonlyInclude": {
    "**/.features-gen/**": true
  }
}
