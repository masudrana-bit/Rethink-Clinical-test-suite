# Normalise line endings to LF in the repository and in the working tree.
#
# Without this, core.autocrlf=true on Windows gives developers CRLF files while
# CI on Linux sees LF, and the formatter disagrees with itself depending on who
# ran it. Declaring it here takes precedence over each developer's git config,
# so the answer is the same everywhere.
* text=auto eol=lf

# Binary evidence — never touch these.
*.zip binary
*.png binary
*.webm binary
